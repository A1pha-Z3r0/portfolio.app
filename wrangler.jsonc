// Cloudflare deploy config: the site is fully static, so Cloudflare just serves
// the built dist/ folder (npm run build makes it). /os/ maps to dist/os/index.html.
{
  "name": "portfolio-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // The site's own domain (bought on Cloudflare). Listed here so every deploy keeps
  // it attached; the workers.dev address keeps working too.
  "routes": [
    { "pattern": "jona-allwin.com", "custom_domain": true },
    { "pattern": "www.jona-allwin.com", "custom_domain": true }
  ]
}
